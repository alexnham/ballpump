# demo works with no credentials. live subscribes to mainnet LaserStream.
SOURCE=demo
# Optional Docker Compose host port (container always listens on port 3000):
# PORT=3000
BIND_ADDR=127.0.0.1:3000
FRONTEND_DIST=frontend/dist
CHECKPOINT_PATH=.ballpump-cursor
RUST_LOG=ballpump=info,helius_laserstream=warn
LASERSTREAM_ENDPOINT=https://laserstream-mainnet-ny.helius-rpc.com
LASERSTREAM_API_KEY=
# Optional frontend override, set before npm run build/dev:
# VITE_WS_URL=ws://127.0.0.1:3000/ws

# demo works with no credentials. live subscribes to mainnet LaserStream.
SOURCE=demo
# Optional Docker Compose host port (container always listens on port 3000):
# PORT=3000
BIND_ADDR=127.0.0.1:3000
FRONTEND_DIST=frontend/dist
CHECKPOINT_PATH=.ballpump-cursor
RUST_LOG=ballpump=info,helius_laserstream=warn
LASERSTREAM_ENDPOINT=https://laserstream-mainnet-ny.helius-rpc.com
LASERSTREAM_API_KEY=
# Optional frontend override, set before npm run build/dev:
# VITE_WS_URL=ws://127.0.0.1:3000/ws

# Optional metadata RPC override. Defaults to Helius mainnet using LASERSTREAM_API_KEY.
# HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=...

# Set false to start at the live head and warm a fresh 10-minute window.
# Useful when historical replay cannot catch up. LaserStream reconnect replay stays enabled.
REPLAY_ON_START=true

# laserstream (default, supports replay) or yellowstone (live finalized, no replay).
STREAM_PROVIDER=laserstream
# Yellowstone uses LASERSTREAM_ENDPOINT=https://your-grpc-host:443 and its x-token
# in LASERSTREAM_API_KEY. Set HELIUS_RPC_URL separately for Helius metadata;
# never send a third-party gRPC token to Helius HTTP RPC.
